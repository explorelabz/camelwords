rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function active(uid) {
   return owner(uid) && !exists(/databases/$(database)/documents/deletedAccounts/$(uid))
    && (!exists(/databases/$(database)/documents/users/$(uid)) || !get(/databases/$(database)/documents/users/$(uid)).data.get('deleting', false));
  }
  function settingsFields() { return ['activeBook','dailyLimit','newCap','autoFill','accent','autoAudio','algorithm','reminder','timezone','planTier','updatedAt']; }
  function settingsValid() {
   let d = request.resource.data;
   return d.dailyLimit is int && d.dailyLimit >= 1 && d.dailyLimit <= 300
    && d.newCap is int && d.newCap >= 0 && d.newCap <= d.dailyLimit
    && d.autoFill is bool && d.autoAudio is bool && d.accent in ['en-US','en-GB']
    && d.algorithm in ['fsrs','sm2'] && d.activeBook is string
    && d.timezone == 'Asia/Tokyo' && d.planTier == 'FREE';
  }
  function eventValid(id) {
   let d=request.resource.data;
   return d.keys().hasAll(['id','kind','wordKey','clientReviewedAt','algorithm','algorithmVersion','before','after','deviceId','serverReceivedAt'])
    && d.keys().hasOnly(['id','kind','wordKey','clientReviewedAt','algorithm','algorithmVersion','before','after','deviceId','serverReceivedAt','action','rating','reviewType'])
    && d.id == id && d.wordKey is string && d.wordKey.matches('^[a-z0-9_-]{1,100}$')
    && d.clientReviewedAt is string && d.clientReviewedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$')
    && d.algorithm in ['fsrs','sm2'] && d.algorithmVersion is string
    && d.deviceId is string && d.deviceId.size() <= 128 && d.serverReceivedAt == request.time
    && (d.before == null || d.before is map) && (d.after == null || d.after is map);
  }
  match /users/{uid} {
   allow read: if owner(uid);
   allow create: if active(uid) && request.resource.data.keys().hasOnly(settingsFields()) && settingsValid();
   allow update: if active(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(settingsFields()) && settingsValid();
   allow delete: if false;
   match /reviewEvents/{id} {
    allow read: if owner(uid);
    allow create: if active(uid) && eventValid(id) && request.resource.data.kind == 'review' && request.resource.data.rating in ['AGAIN','HARD','GOOD'];
    allow update, delete: if false;
   }
   match /stateEvents/{id} {
    allow read: if owner(uid);
    allow create: if active(uid) && eventValid(id) && request.resource.data.kind == 'state' && request.resource.data.action in ['MASTER','PREFILTER','RESTORE','REMOVE','UNDO_MASTER','QUEUE_ADD','QUEUE_REMOVE','QUEUE_REORDER'];
    allow update, delete: if false;
   }
   match /wordStates/{key} { allow read: if owner(uid); allow write: if false; }
   match /{collection}/{id} {
    allow read: if owner(uid) && collection in ['queue','dailyPlans','diagnostics','deviceBackups'];
    allow write: if active(uid) && collection in ['queue','dailyPlans','diagnostics','deviceBackups'];
   }
  }
  match /contentPackages/{id} {
   allow read: if resource.data.status == 'PUBLISHED'; allow write: if false;
   match /versions/{version} { allow read: if resource.data.status == 'PUBLISHED'; allow write: if false; }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
