{
  "name": "camelwords",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "preview": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "export": "expo export --platform web",
    "test:rules": "firebase emulators:exec --only firestore --project demo-camelwords \"node --test tests/firebase/rules.test.mjs\"",
    "content": "node tools/content-cli.mjs",
    "format": "prettier --write app src functions/src tools tests"
  },
